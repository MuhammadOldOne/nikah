# Настройки «Истины» для сервера (docker compose).
#   cp .env.example .env  и заполните пустые значения.
# В .env будут секреты: не коммитьте его, не пересылайте и не публикуйте.
# Для разработки без Docker .env не обязателен: значения по умолчанию рассчитаны на локальный запуск (README.md).
# Комментарии пишите только отдельными строками, не после значения.

# Переносите .env старого бота так (docs/DEPLOY.md, «Настройки из старого бота»):
#   BOT_TOKEN       -> TELEGRAM_TOKEN (имя BOT_TOKEN тоже принимается)
#   ADMIN_IDS       -> ADMIN_TELEGRAM_IDS (имя ADMIN_IDS тоже принимается)
#   WITNESS_CHAT_ID -> WITNESS_CHAT_ID (как есть)
#   TELEGRAM_PROXY  -> TELEGRAM_PROXY (адрес 127.0.0.1 работает только с docker-compose.hostproxy.yml)
#   DB_PATH         -> не нужен: путь к копии data.db передаётся скрипту переноса (docs/CUTOVER.md).

# ---------- Сервер (используется docker-compose.yml) ----------

# Режим развёртывания (docs/DEPLOY.md). Файлы перечисляются через двоеточие.
#   Caddy (по умолчанию): строку не трогайте. Caddy занимает порты 80/443 и сам получает HTTPS.
#   nginx (порты 80/443 уже заняты nginx): сайт слушает 127.0.0.1:WEB_HOST_PORT, Caddy не запускается:
#     COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml
#   Прокси Telegram на этом сервере слушает 127.0.0.1 — добавьте в конец :docker-compose.hostproxy.yml
#   Прокси слушает docker-интерфейс (172.17.0.1) — добавьте :docker-compose.hostgateway.yml
#   Например, nginx + прокси на 127.0.0.1:
#     COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml:docker-compose.hostproxy.yml
# COMPOSE_FILE=docker-compose.yml

# Порт сайта на 127.0.0.1 в режиме nginx, если 8000 уже занят (тот же порт — в deploy/nginx/nikah.conf).
# WEB_HOST_PORT=8000

# Порт PostgreSQL на 127.0.0.1 для бота в режиме docker-compose.hostproxy.yml, если 5432 уже занят.
# Наружу база не публикуется ни в одном режиме.
# POSTGRES_HOST_PORT=5432

# Домен сайта без https:// и без слеша. На него должна указывать A-запись DNS.
# В режиме Caddy сертификат получается и продлевается сам; в режиме nginx — через certbot.
DOMAIN=example.ru

# Пароль базы данных PostgreSQL. Сгенерируйте командой:
#   openssl rand -hex 24
# (только латинские буквы и цифры: пароль подставляется в адрес подключения к базе).
# После первого запуска не меняйте: база уже создана с этим паролем.
POSTGRES_PASSWORD=

# ---------- Приложение (app/config.py) ----------

# Режим работы: prod на сервере, dev только для разработки.
ENV=prod

# Адрес подключения к базе. В docker compose собирается автоматически из POSTGRES_PASSWORD,
# здесь его задавать не нужно. Для запуска без Docker:
#   DATABASE_URL=postgresql+asyncpg://пользователь:пароль@127.0.0.1:5432/nikah
# DATABASE_URL=

# Токен бота от @BotFather. Тот же токен, что у текущего @nikah_istina_bot:
# пользователи продолжают общаться с тем же ботом. Перед запуском остановите старый бот (docs/CUTOVER.md).
# Имя переменной из .env старого бота (BOT_TOKEN) тоже принимается; если заданы обе, действует TELEGRAM_TOKEN.
TELEGRAM_TOKEN=

# Прокси для запросов к api.telegram.org, если прямой доступ с сервера закрыт:
#   http://<адрес_прокси>:<порт>  или  socks5://<логин>:<пароль>@<адрес_прокси>:<порт>
# https:// не поддерживается (бот не запустится и скажет об этом). Пусто — напрямую. В логи не пишется.
# Прокси на этом же сервере: http://127.0.0.1:<порт> + docker-compose.hostproxy.yml
# или http://host.docker.internal:<порт> + docker-compose.hostgateway.yml (см. COMPOSE_FILE выше).
TELEGRAM_PROXY=

# ID группы свидетелей (обычно отрицательный, -100...). В неё приходят копии всех сообщений чатов,
# уведомления об открытии и закрытии чатов и жалобы. Пусто — копии получает в личку каждый админ.
WITNESS_CHAT_ID=

# Юзернейм бота без @ (для ссылок t.me/... на сайте и в боте).
BOT_USERNAME=nikah_istina_bot

# Публичный адрес сайта без слеша в конце. В docker compose задаётся автоматически: https://<DOMAIN>.
# Для запуска без Docker:
#   SITE_URL=https://example.ru
# SITE_URL=

# Секретный ключ для подписи сессий сайта: случайная строка не короче 32 символов.
# Без него при ENV=prod приложение не запустится. Сгенерируйте одной из команд:
#   openssl rand -base64 48
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если ключ сменить, все пользователи выйдут с сайта (в боте ничего не изменится).
SECRET_KEY=

# Telegram ID администраторов через запятую, например: 111111111,222222222
# Свой ID можно узнать, например, у бота @userinfobot.
# Админам открыта страница /admin, им приходят новые анкеты на модерацию и жалобы.
# Права можно выдать и без перезапуска: scripts/make_admin.py (docs/DEPLOY.md).
# Имя переменной из .env старого бота (ADMIN_IDS) тоже принимается; если заданы обе, действует ADMIN_TELEGRAM_IDS.
ADMIN_TELEGRAM_IDS=

# Премодерация: новые и изменённые анкеты появляются в каталоге только после одобрения админом.
PREMODERATION=true

# Сколько новых откликов один человек может отправить за 24 часа.
INTEREST_DAILY_LIMIT=10

# Сколько открытых чатов может быть у одного человека одновременно (как в старом боте — один).
MAX_OPEN_CONVERSATIONS=1

# Сколько сообщений в минуту один человек может отправить в чаты (сайт и Telegram вместе).
CHAT_RATE_LIMIT_PER_MIN=20

# Вход на сайт без Telegram, только для разработки. При ENV=prod всегда выключен.
DEV_LOGIN_ENABLED=false

# Кнопка-виджет «Войти через Telegram» на странице /login.
# Включайте только после команды /setdomain в @BotFather (docs/DEPLOY.md, раздел 9).
TELEGRAM_WIDGET_ENABLED=false

# Cookie сессии только по HTTPS. По умолчанию включено при ENV=prod, менять не нужно.
# SESSION_COOKIE_SECURE=true
